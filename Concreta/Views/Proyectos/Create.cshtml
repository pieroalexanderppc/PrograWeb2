@model ProyectoFormVM
@{
    ViewBag.Title = "Nuevo proyecto";
    ViewBag.Seccion = "Proyectos";
    ViewBag.SeccionUrl = Url.Action("Index");
}
<div class="page-head">
    <div><h1>Nuevo proyecto</h1></div>
</div>
<div style="max-width:720px">
    @using (Html.BeginForm("Create", "Proyectos", FormMethod.Post))
    {
        @Html.Partial("_Form", Model)
        <div class="form-actions">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i>Guardar</button>
            <a class="btn btn-secondary" href="@Url.Action("Index")">Cancelar</a>
        </div>
    }
</div>
