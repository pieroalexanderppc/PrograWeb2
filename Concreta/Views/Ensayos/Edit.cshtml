@model EnsayoFormVM
@{
    ViewBag.Title = "Editar ensayo";
    ViewBag.Seccion = Model.CodigoDiseno;
    ViewBag.SeccionUrl = Url.Action("Details", "Disenos", new { id = Model.IdDiseno });
}
<div class="page-head">
    <div>
        <h1>Editar ensayo</h1>
        <div class="meta">Diseño <span class="code">@Model.CodigoDiseno</span></div>
    </div>
</div>
<div style="max-width:640px">
    @using (Html.BeginForm("Edit", "Ensayos", new { id = Model.IdEnsayo }, FormMethod.Post))
    {
        @Html.Partial("_EnsayoForm", Model)
        <div class="form-actions mt-4">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i>Guardar cambios</button>
            <a class="btn btn-secondary" href="@Url.Action("Details", "Disenos", new { id = Model.IdDiseno })">Cancelar</a>
        </div>
    }
</div>
