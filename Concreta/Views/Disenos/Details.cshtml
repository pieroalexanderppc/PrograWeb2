@model DisenoDetalleVM
@{
    var d = Model.Diseno;
    ViewBag.Title = d.Codigo;
    ViewBag.Seccion = "Diseños";
    ViewBag.SeccionUrl = Url.Action("Index");
    var ensayos = d.Ensayos.OrderBy(e => e.FechaEnsayo).ThenBy(e => e.EdadDias).ToList();
}
<div class="page-head">
    <div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <h1 class="num" style="font-family:var(--cc-font-mono)">@d.Codigo</h1>
            @Html.Partial("_EstadoBadge", d.Estado)
            @Html.Partial("_ResistenciaBadge", Model.EstadoResistencia)
        </div>
        <div class="meta">
            <a href="@Url.Action("Index", new { proyecto = d.IdProyecto })">@d.Proyecto.Nombre</a>
            @if (!string.IsNullOrEmpty(d.Descripcion)) { <span>@d.Descripcion</span> }
            <span>f'c @d.FcKgCm2 kg/cm² · asentamiento @Formato.Pulg(d.AsentamientoPulg)" · TMN @d.TamanoMaxNominal</span>
            <span>@d.MetodoDiseno · @Formato.Fecha(d.FechaCreacion) · @d.Usuario.NombreCompleto</span>
        </div>
    </div>
    <div class="page-actions">
        @if (Model.PuedeEditar)
        {
            <a class="btn btn-secondary" href="@Url.Action("Create", "Comparaciones", new { ids = d.IdDiseno })"><i class="bi bi-layout-split"></i>Comparar con…</a>
            <div class="dropdown">
                <button class="btn btn-secondary" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Cambiar estado"><i class="bi bi-three-dots"></i></button>
                <div class="dropdown-menu dropdown-menu-end">
                    @foreach (var estado in new[] { DisenoMezcla.Aprobado, DisenoMezcla.Descartado, DisenoMezcla.Calculado })
                    {
                        if (estado == d.Estado) { continue; }
                        using (Html.BeginForm("CambiarEstado", "Disenos", new { id = d.IdDiseno, estado = estado }, FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <button type="submit" class="dropdown-item">Marcar como @estado.ToLowerInvariant()</button>
                        }
                    }
                </div>
            </div>
        }
        @if (Model.PuedeRegistrarEnsayo)
        {
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalEnsayo"><i class="bi bi-clipboard-plus"></i>Registrar ensayo</button>
        }
    </div>
</div>

<div class="section">
    @Html.Partial("_KpiStrip", Model.Kpis)
</div>

<div class="section">
    <div class="section-head"><h2>Composición del m³</h2></div>
    @Html.Partial("_MixBar", Model.Dosificacion)
</div>

<div class="section">
    <div class="section-head">
        <h2>Dosificación por m³</h2>
        <span class="meta">f'cr <span class="num">@(d.FcrKgCm2?.ToString() ?? "—")</span> kg/cm² · aire atrapado <span class="num">@Formato.Pct(d.AireAtrapado)</span> %</span>
    </div>
    @Html.Partial("_Dosificacion", Model.Dosificacion)
</div>

<div class="section">
    <div class="section-head">
        <h2>Ensayos de laboratorio</h2>
        @if (Model.Resistencia28d != null)
        {
            <span class="meta">Resistencia a 28 días: @Html.Num(Formato.Kg(Model.Resistencia28d), "kg/cm²") (@Formato.Pct(Model.Resistencia28d / d.FcKgCm2 * 100m) % de f'c)</span>
        }
    </div>
    <div class="table-wrap">
        <table class="table-cc">
            <thead>
                <tr>
                    <th scope="col">Fecha</th>
                    <th scope="col" class="num">Edad<span class="th-unit">días</span></th>
                    <th scope="col">Tipo</th>
                    <th scope="col" class="num">Valor</th>
                    <th scope="col" class="num">% de f'c</th>
                    <th scope="col">Resultado</th>
                    <th scope="col">Registrado por</th>
                </tr>
            </thead>
            <tbody>
                @if (!ensayos.Any())
                {
                    <tr>
                        <td colspan="7" class="empty">
                            Aún no hay ensayos para este diseño.
                            @if (Model.PuedeRegistrarEnsayo) {<button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalEnsayo">Registrar ensayo</button>}
                        </td>
                    </tr>
                }
                @foreach (var e in ensayos)
                {
                    bool esCompresion = e.TipoEnsayo == EnsayoLaboratorio.Compresion;
                    <tr>
                        <td class="num" style="text-align:left">@Formato.Fecha(e.FechaEnsayo)</td>
                        <td class="num">@(e.EdadDias?.ToString() ?? "—")</td>
                        <td>@Opciones.EtiquetaTipoEnsayo(e.TipoEnsayo)</td>
                        <td class="num">@e.ValorObtenido.ToString("N1", Formato.Pe)<span class="unit">@e.Unidad.Replace("2", "²").Replace("m3", "m³")</span></td>
                        <td class="num">@(esCompresion ? Formato.Pct(e.ValorObtenido / d.FcKgCm2 * 100m) + " %" : "—")</td>
                        <td>
                            @if (esCompresion && e.EdadDias == 28)
                            {
                                @Html.Partial("_ResistenciaBadge", e.ValorObtenido >= d.FcKgCm2 ? EstadoResistencia.Cumple : EstadoResistencia.NoCumple)
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>@e.Usuario.NombreCompleto</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="help mt-2">El diseño cumple si el ensayo de compresión a 28 días alcanza f'c = @d.FcKgCm2 kg/cm².</div>
</div>

@if (Model.PuedeRegistrarEnsayo)
{
    <div class="modal fade" id="modalEnsayo" tabindex="-1" aria-labelledby="modalEnsayoTitulo" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            @using (Html.BeginForm("Create", "Ensayos", FormMethod.Post, new { @class = "modal-content" }))
            {
                <div class="modal-header">
                    <h2 class="modal-title" id="modalEnsayoTitulo">Registrar ensayo · <span class="code">@d.Codigo</span></h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    @Html.Partial("~/Views/Ensayos/_EnsayoForm.cshtml", Model.NuevoEnsayo)
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i>Guardar ensayo</button>
                </div>
            }
        </div>
    </div>
}
