@model ComparacionDetalleVM
@{
    var c = Model.Comparacion;
    ViewBag.Title = c.Nombre;
    ViewBag.Seccion = "Comparar";
    ViewBag.SeccionUrl = Url.Action("Index");
    var cols = Model.Columnas;

    // La mejor celda de cada fila va en negrita
    decimal minCosto = cols.Min(x => x.Diseno.CostoTotalM3 ?? decimal.MaxValue);
    decimal minCO2 = cols.Min(x => x.Diseno.HuellaCO2M3 ?? decimal.MaxValue);
    decimal minCemento = cols.Min(x => x.CementoKg);
    decimal maxR28 = cols.Max(x => x.Resistencia28d ?? 0m);
    decimal maxPuntaje = cols.Max(x => x.Puntaje);
    Func<bool, string> best = b => b && cols.Count > 1 ? "best" : "";
}
<div class="page-head">
    <div>
        <h1>@c.Nombre</h1>
        <div class="meta">
            <span>Criterio: @Criterio.Etiqueta(c.Criterio)</span>
            <span>@Formato.Fecha(c.FechaComparacion) · @c.Usuario.NombreCompleto</span>
        </div>
    </div>
    <div class="page-actions">
        <a class="btn btn-secondary" href="@(Url.Action("Create") + "?" + string.Join("&", cols.Select(x => "ids=" + x.Diseno.IdDiseno)))"><i class="bi bi-arrow-repeat"></i>Comparar de nuevo</a>
    </div>
</div>

<div class="section">
    @if (Model.Recomendada != null)
    {
        <div class="reco">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="eyebrow" style="color:var(--cc-brand)">Recomendado</span>
                    <span class="badge bg-light text-dark border" style="font-size:11px">Algoritmo ACI</span>
                </div>
                <a class="reco-code d-block" href="@Url.Action("Details", "Disenos", new { id = Model.Recomendada.Diseno.IdDiseno })">@Model.Recomendada.Diseno.Codigo</a>
                <p class="reco-text">@Formato.Quimica(c.Justificacion)</p>
            </div>
            <div class="reco-score">
                <div class="eyebrow">Puntaje</div>
                <span class="num">@Formato.Pct(Model.Recomendada.Puntaje)</span><span class="unit">/ 100</span>
            </div>
        </div>
    }
    else
    {
        <div class="alert-cc warn"><i class="bi bi-exclamation-triangle"></i><div>@Formato.Quimica(c.Justificacion)</div></div>
    }

    <div class="ai-panel mt-3">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="ai-badge"><i class="bi bi-stars"></i> IA Concreta</span>
                <span style="font-weight:600;font-size:14px">Justificación Ejecutiva & Análisis Multidimensional</span>
            </div>
            <button type="button" class="btn btn-secondary btn-sm" id="btnIaComp">
                <i class="bi bi-robot"></i> <span id="btnTextoIaComp">Generar con IA</span>
            </button>
        </div>
        <div id="cargandoIaComp" class="text-center py-3" style="display:none">
            <div class="spinner-border text-success" role="status" style="width:1.5rem;height:1.5rem">
                <span class="visually-hidden">Generando informe ejecutivo...</span>
            </div>
            <div class="meta mt-1" style="font-size:13px">Comparando impacto ambiental, durabilidad y costo con Gemini...</div>
        </div>
        <div id="resultadoIaComp" class="ai-content mt-2 p-3 bg-white rounded border" style="display:none">
            <div id="textoIaComp"></div>
        </div>
    </div>
</div>

<div class="section">
    <div class="section-head"><h2>Comparación lado a lado</h2></div>
    <div class="table-wrap">
        <table class="table-cc">
            <thead>
                <tr>
                    <th scope="col">Indicador</th>
                    @foreach (var col in cols)
                    {
                        <th scope="col" class="num">
                            <a class="code-link" href="@Url.Action("Details", "Disenos", new { id = col.Diseno.IdDiseno })">@col.Diseno.Codigo</a>
                            <span class="th-unit">#@col.Posicion</span>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Cemento</td>
                    @foreach (var col in cols) { <td class="num" style="font-family:var(--cc-font-sans);font-size:13px">@col.Cemento</td> }
                </tr>
                <tr>
                    <td>f'c <span class="unit">kg/cm²</span></td>
                    @foreach (var col in cols) { <td class="num">@col.Diseno.FcKgCm2</td> }
                </tr>
                <tr>
                    <td>Relación a/c</td>
                    @foreach (var col in cols) { <td class="num">@Formato.AC(col.Diseno.RelacionAC)</td> }
                </tr>
                <tr>
                    <td>Cemento <span class="unit">kg/m³</span></td>
                    @foreach (var col in cols) { <td class="num @best(col.CementoKg == minCemento)">@Formato.Kg(col.CementoKg)</td> }
                </tr>
                <tr>
                    <td>Costo <span class="unit">S/ por m³</span></td>
                    @foreach (var col in cols) { <td class="num @best(col.Diseno.CostoTotalM3 == minCosto)">@Formato.Soles(col.Diseno.CostoTotalM3)</td> }
                </tr>
                <tr>
                    <td>Huella CO₂ <span class="unit">kg CO₂e/m³</span></td>
                    @foreach (var col in cols) { <td class="num @best(col.Diseno.HuellaCO2M3 == minCO2)">@Formato.CO2(col.Diseno.HuellaCO2M3)</td> }
                </tr>
                <tr>
                    <td>Resistencia a 28 días <span class="unit">kg/cm²</span></td>
                    @foreach (var col in cols) { <td class="num @best(col.Resistencia28d != null && col.Resistencia28d == maxR28)">@Formato.Kg(col.Resistencia28d)</td> }
                </tr>
                <tr>
                    <td>Estado</td>
                    @foreach (var col in cols) { <td class="num">@Html.Partial("_ResistenciaBadge", col.Estado)</td> }
                </tr>
                <tr>
                    <td>Puntaje <span class="unit">/ 100</span></td>
                    @foreach (var col in cols) { <td class="num @best(col.Puntaje == maxPuntaje)">@Formato.Pct(col.Puntaje)</td> }
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="section">
    <div class="section-head"><h2>Composición del m³</h2></div>
    @foreach (var col in cols)
    {
        <div class="mix-row">
            <span class="code">@col.Diseno.Codigo</span>
            <div>@Html.Partial("_MixBar", new DosificacionVM { Segmentos = col.Dosificacion.Segmentos, MostrarLeyenda = false })</div>
        </div>
    }
    @if (cols.Any())
    {
        <div class="mix-row">
            <span></span>
            <div class="mix-legend" style="margin-top:0">
                @foreach (var s in cols.SelectMany(x => x.Dosificacion.Segmentos).GroupBy(x => x.Nombre).Select(g => g.First()))
                {
                    <span><span class="sw @(s.Nombre == "Aire" ? "aire" : "")" style="background:var(@s.ColorVar)"></span>@s.Nombre</span>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        var btnIaComp = document.getElementById('btnIaComp');
        var btnTextoIaComp = document.getElementById('btnTextoIaComp');
        var cargandoIaComp = document.getElementById('cargandoIaComp');
        var resultadoIaComp = document.getElementById('resultadoIaComp');
        var textoIaComp = document.getElementById('textoIaComp');

        function renderizarMarkdownIa(texto) {
            if (!texto) return '';
            var src = String(texto).replace(/\r\n/g, '\n').replace(/\r/g, '\n');

            src = src.replace(/^(?:Como\s+[^:\n]+[:\.\-]|A\s+continuación[^:\n]+[:\.\-]|Presento\s+el\s+dictamen[^:\n]+[:\.\-]|En\s+calidad\s+de[^:\n]+[:\.\-])\s*/i, '');
            var idxInicio = src.search(/(?:#{1,4}\s*1\.|\b1\.\s+[A-ZÁÉÍÓÚ]|###\s+Opción|###|\bOpción)/i);
            if (idxInicio > 0 && idxInicio < 400) {
                src = src.substring(idxInicio);
            }

            src = src.replace(/([^\n])\s*(#{1,4}\s*)/g, '$1\n\n$2');
            src = src.replace(/([^\n])\s*(\b[1-4]\.\s+[A-ZÁÉÍÓÚ])/g, '$1\n\n$2');
            src = src.replace(/([^\n])\s*([-\*•]\s*\*\*)/g, '$1\n$2');
            src = src.replace(/([^\n])\s*([-\*•]\s+[A-ZÁÉÍÓÚ])/g, '$1\n$2');

            src = src.replace(/^###\s*(.*$)/gim, '<h5 class="ai-heading">$1</h5>');
            src = src.replace(/^##\s*(.*$)/gim, '<h4 class="ai-heading">$1</h4>');
            src = src.replace(/^#\s*(.*$)/gim, '<h4 class="ai-heading">$1</h4>');
            src = src.replace(/^(\d+\.\s+[^\n<]+)/gim, '<h4 class="ai-heading">$1</h4>');

            src = src.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');

            var lineas = src.split('\n');
            var resultado = [];
            var enLista = false;

            for (var i = 0; i < lineas.length; i++) {
                var linea = lineas[i].trim();
                if (!linea) {
                    if (enLista) { resultado.push('</ul>'); enLista = false; }
                    continue;
                }

                if (linea.indexOf('<h4') === 0 || linea.indexOf('<h5') === 0) {
                    if (enLista) { resultado.push('</ul>'); enLista = false; }
                    linea = linea.replace(/\*/g, '').replace(/#{1,4}/g, '').trim();
                    resultado.push(linea);
                    continue;
                }

                var matchVineta = linea.match(/^[\*\-\•\+]\s*(.*)$/);
                if (matchVineta) {
                    if (!enLista) { resultado.push('<ul class="ai-bullet-list">'); enLista = true; }
                    var contenido = matchVineta[1].trim();
                    contenido = contenido.replace(/^[\*\-\•\+]\s*/, '');
                    contenido = contenido.replace(/\*([^*]+)\*/g, '<em>$1</em>');
                    if (contenido.indexOf('<strong>') === -1) {
                        contenido = contenido.replace(/^([^:]{3,45}:)/, '<strong>$1</strong>');
                    }
                    contenido = contenido.replace(/\*/g, '');
                    resultado.push('<li>' + contenido + '</li>');
                } else {
                    if (enLista) { resultado.push('</ul>'); enLista = false; }
                    linea = linea.replace(/\*([^*]+)\*/g, '<em>$1</em>');
                    linea = linea.replace(/\*/g, '');
                    resultado.push('<p class="ai-para">' + linea + '</p>');
                }
            }

            if (enLista) resultado.push('</ul>');
            return resultado.join('\n');
        }

        if (btnIaComp) {
            btnIaComp.addEventListener('click', function () {
                btnIaComp.disabled = true;
                btnTextoIaComp.textContent = 'Generando...';
                cargandoIaComp.style.display = 'block';
                resultadoIaComp.style.display = 'none';

                fetch('@Url.Action("JustificacionIa", "Comparaciones", new { id = c.IdComparacion })', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                })
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    cargandoIaComp.style.display = 'none';
                    btnIaComp.disabled = false;
                    btnTextoIaComp.textContent = 'Regenerar con IA';
                    if (data.ok) {
                        textoIaComp.innerHTML = renderizarMarkdownIa(data.justificacion);
                        resultadoIaComp.style.display = 'block';
                    } else {
                        textoIaComp.innerHTML = '<div class="alert alert-danger">' + (data.error || 'Error al consultar la IA.') + '</div>';
                        resultadoIaComp.style.display = 'block';
                    }
                })
                .catch(function (err) {
                    cargandoIaComp.style.display = 'none';
                    btnIaComp.disabled = false;
                    btnTextoIaComp.textContent = 'Generar con IA';
                    textoIaComp.innerHTML = '<div class="alert alert-danger">Error de red: ' + err.message + '</div>';
                    resultadoIaComp.style.display = 'block';
                });
            });
        }
    </script>
}
