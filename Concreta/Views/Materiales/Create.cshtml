@model MaterialFormVM
@{
    ViewBag.Title = "Nuevo material";
    ViewBag.Seccion = "Materiales";
    ViewBag.SeccionUrl = Url.Action("Index");
}
<div class="page-head">
    <div>
        <h1>Nuevo material</h1>
        <div class="meta">Los campos de propiedades cambian según el tipo de material.</div>
    </div>
</div>
<div style="max-width:880px">
    @using (Html.BeginForm("Create", "Materiales", FormMethod.Post))
    {
        @Html.Partial("_Form", Model)
        <div class="form-actions">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i>Guardar</button>
            <a class="btn btn-secondary" href="@Url.Action("Index")">Cancelar</a>
        </div>
    }
</div>
