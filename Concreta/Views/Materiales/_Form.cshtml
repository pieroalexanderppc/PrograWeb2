@model MaterialFormVM
@Html.AntiForgeryToken()
@Html.ValidationSummary(true)

<div class="form-section">
    <h2 class="section-title">Identificación</h2>
    <div class="row g-3">
        <div class="col-md-4">
            @Html.LabelFor(m => m.IdTipoMaterial, new { @class = "form-label" })
            @Html.DropDownListFor(m => m.IdTipoMaterial, Model.Tipos, "Selecciona…", new { @class = "form-select" })
            @Html.ValidationMessageFor(m => m.IdTipoMaterial)
        </div>
        <div class="col-md-8">
            @Html.LabelFor(m => m.Nombre, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", placeholder = "Cemento Portland Puzolánico Tipo IP" })
            @Html.ValidationMessageFor(m => m.Nombre)
        </div>
        <div class="col-md-8">
            @Html.LabelFor(m => m.Proveedor, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.Proveedor, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Proveedor)
        </div>
        <div class="col-md-4 d-flex align-items-end">
            <div class="form-check mb-2">
                @Html.CheckBoxFor(m => m.Activo, new { @class = "form-check-input" })
                @Html.LabelFor(m => m.Activo, "Activo (disponible para nuevos diseños)", new { @class = "form-check-label" })
            </div>
        </div>
    </div>
</div>

<div class="form-section">
    <h2 class="section-title">Propiedades físicas</h2>
    <div class="row g-3">
        <div class="col-md-4">
            @Html.LabelFor(m => m.PesoEspecifico, new { @class = "form-label" })
            <div class="input-group">
                @Html.TextBoxFor(m => m.PesoEspecifico, new { @class = "form-control input-num", type = "number", step = "0.001" })
                <span class="input-group-text">g/cm³</span>
            </div>
            @Html.ValidationMessageFor(m => m.PesoEspecifico)
        </div>
        <div class="col-md-4" data-mostrar-si="IdTipoMaterial:Cemento">
            @Html.LabelFor(m => m.PorcentajeAdicion, new { @class = "form-label" })
            <div class="input-group">
                @Html.TextBoxFor(m => m.PorcentajeAdicion, new { @class = "form-control input-num", type = "number", step = "0.01" })
                <span class="input-group-text">%</span>
            </div>
            <div class="help">Puzolana, escoria o filler. Tipo I = 0 %.</div>
            @Html.ValidationMessageFor(m => m.PorcentajeAdicion)
        </div>
        <div class="col-md-4" data-mostrar-si="IdTipoMaterial:Agregado fino">
            @Html.LabelFor(m => m.ModuloFineza, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.ModuloFineza, new { @class = "form-control input-num", type = "number", step = "0.01" })
            <div class="help">Se usa para el volumen de agregado grueso (ACI 211.1).</div>
            @Html.ValidationMessageFor(m => m.ModuloFineza)
        </div>
        <div class="col-md-4" data-mostrar-si="IdTipoMaterial:Agregado grueso">
            @Html.LabelFor(m => m.TamanoMaxNominal, new { @class = "form-label" })
            @Html.DropDownListFor(m => m.TamanoMaxNominal, new SelectList(Opciones.Tmn, Model.TamanoMaxNominal), "Selecciona…", new { @class = "form-select" })
            @Html.ValidationMessageFor(m => m.TamanoMaxNominal)
        </div>
        <div class="col-md-4" data-mostrar-si="IdTipoMaterial:Agregado grueso">
            @Html.LabelFor(m => m.PesoUnitarioCompactado, new { @class = "form-label" })
            <div class="input-group">
                @Html.TextBoxFor(m => m.PesoUnitarioCompactado, new { @class = "form-control input-num", type = "number", step = "1" })
                <span class="input-group-text">kg/m³</span>
            </div>
            @Html.ValidationMessageFor(m => m.PesoUnitarioCompactado)
        </div>
        <div class="col-md-4" data-mostrar-si="IdTipoMaterial:Agregado fino|Agregado grueso">
            @Html.LabelFor(m => m.Absorcion, new { @class = "form-label" })
            <div class="input-group">
                @Html.TextBoxFor(m => m.Absorcion, new { @class = "form-control input-num", type = "number", step = "0.01" })
                <span class="input-group-text">%</span>
            </div>
            @Html.ValidationMessageFor(m => m.Absorcion)
        </div>
        <div class="col-md-4" data-mostrar-si="IdTipoMaterial:Agregado fino|Agregado grueso">
            @Html.LabelFor(m => m.ContenidoHumedad, new { @class = "form-label" })
            <div class="input-group">
                @Html.TextBoxFor(m => m.ContenidoHumedad, new { @class = "form-control input-num", type = "number", step = "0.01" })
                <span class="input-group-text">%</span>
            </div>
            @Html.ValidationMessageFor(m => m.ContenidoHumedad)
        </div>
    </div>
</div>

<div class="form-section">
    <h2 class="section-title">Costo y huella de carbono</h2>
    <div class="row g-3">
        <div class="col-md-4">
            @Html.LabelFor(m => m.CostoKg, new { @class = "form-label" })
            <div class="input-group">
                @Html.TextBoxFor(m => m.CostoKg, new { @class = "form-control input-num", type = "number", step = "0.0001" })
                <span class="input-group-text">S/ por kg</span>
            </div>
            @Html.ValidationMessageFor(m => m.CostoKg)
        </div>
        <div class="col-md-4">
            @Html.LabelFor(m => m.FactorCO2Kg, new { @class = "form-label" })
            <div class="input-group">
                @Html.TextBoxFor(m => m.FactorCO2Kg, new { @class = "form-control input-num", type = "number", step = "0.00001" })
                <span class="input-group-text">kg CO₂e/kg</span>
            </div>
            @Html.ValidationMessageFor(m => m.FactorCO2Kg)
        </div>
        <div class="col-12">
            <div class="help">Valores referenciales del prototipo: reemplázalos por las fichas técnicas del proveedor.</div>
        </div>
    </div>
</div>
