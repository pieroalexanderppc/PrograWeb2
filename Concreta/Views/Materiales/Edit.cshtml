@model MaterialFormVM
@{
    ViewBag.Title = Model.Nombre;
    ViewBag.Seccion = "Materiales";
    ViewBag.SeccionUrl = Url.Action("Index");
}
<div class="page-head">
    <div>
        <h1>Editar material</h1>
        <div class="meta">@Model.Nombre</div>
    </div>
</div>
<div style="max-width:880px">
    @using (Html.BeginForm("Edit", "Materiales", new { id = Model.IdMaterial }, FormMethod.Post))
    {
        @Html.HiddenFor(m => m.IdMaterial)
        @Html.Partial("_Form", Model)
        <div class="form-actions">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i>Guardar cambios</button>
            <a class="btn btn-secondary" href="@Url.Action("Index")">Cancelar</a>
        </div>
    }
</div>
