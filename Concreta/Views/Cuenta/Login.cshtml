@model LoginVM
@{
    Layout = null;
    bool hayFoto = System.IO.File.Exists(Server.MapPath("~/Content/img/concreto.jpg"));
}
<!DOCTYPE html>
<html lang="es-PE">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ingresar · Concreta</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="~/Content/site.css" rel="stylesheet">
</head>
<body>
    <div class="login">
        <div class="login-form">
            <div>
                <div class="brand" style="padding:0;border:0;height:auto;margin-bottom:40px"><span class="brand-mark"></span>CONCRETA</div>
                <h1 style="margin-bottom:6px">Ingresa a Concreta</h1>
                <p class="meta" style="margin-bottom:28px">Diseño de mezclas de concreto con cementos adicionados.</p>

                @using (Html.BeginForm("Login", "Cuenta", FormMethod.Post, new { novalidate = "novalidate" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.ReturnUrl)
                    @Html.ValidationSummary(true)

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Correo, new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Correo, new { @class = "form-control", type = "email", autocomplete = "username", autofocus = "autofocus", placeholder = "nombre@concreta.pe" })
                        @Html.ValidationMessageFor(m => m.Correo)
                    </div>
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Contrasena, new { @class = "form-label" })
                        @Html.PasswordFor(m => m.Contrasena, new { @class = "form-control", autocomplete = "current-password" })
                        @Html.ValidationMessageFor(m => m.Contrasena)
                    </div>
                    <div class="form-check mb-4">
                        @Html.CheckBoxFor(m => m.Recordar, new { @class = "form-check-input" })
                        @Html.LabelFor(m => m.Recordar, new { @class = "form-check-label", style = "font-size:14px" })
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Ingresar</button>
                }

                @if (HttpContext.Current.IsDebuggingEnabled)
                {
                    <div class="demo-users">
                        Usuarios de prueba (contraseña <code>Concreta123*</code>):<br />
                        <code>admin@@concreta.pe</code> · <code>cmamani@@concreta.pe</code> · <code>lquispe@@concreta.pe</code>
                    </div>
                }
            </div>
        </div>
        <div class="login-side" style="@(hayFoto ? "background-image:url('" + Url.Content("~/Content/img/concreto.jpg") + "')" : null)">
            @if (!hayFoto)
            {
                <p>Diseña mezclas que cumplen, cuestan menos y emiten menos.</p>
            }
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
